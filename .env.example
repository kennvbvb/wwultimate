# คัดลอกเป็น .env.local แล้วเติมค่าจริง (ห้าม commit .env.local)

# Neon Postgres — ได้จาก Vercel Storage หรือ vercel env pull
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# กุญแจเซ็น cookie ผู้ดำเนินเกม ยาวอย่างน้อย 16 ตัวอักษร
AUTH_SECRET=

# รหัสผ่านหน้าแอดมินแก้บทบาท (คนละตัวกับ PIN ของเกม)
ADMIN_PASSWORD=

# ปรับโควตาการเรียกต่อช่วงเวลาได้ (ค่าเริ่มต้น: สร้างเกม 30/ชม., PIN 10/10 นาที, แอดมิน 5/10 นาที)
# RATE_LIMIT_CREATE_GAME=30
# RATE_LIMIT_MODERATOR_LOGIN=10
# RATE_LIMIT_ADMIN_LOGIN=5

# ตั้งเป็น true เมื่อแก้ค่า Village Impact ให้ตรงการ์ดจริงครบทั้ง 46 บทบาทแล้ว
# VILLAGE_IMPACT_VERIFIED=true
